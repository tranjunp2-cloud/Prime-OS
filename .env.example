PRIME_ALLOWED_ORIGINS=https://prime.example.com,https://admin-prime.example.com
PRIME_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
PRIME_ADMIN_EMAIL=admin@example.com
PRIME_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PRIME_USER_EMAIL=user@example.com
PRIME_USER_PASSWORD=replace-with-a-strong-user-password

# Only use this on a private local machine, never on a public domain.
PRIME_ALLOW_DEMO_CREDENTIALS=false

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-anon-or-publishable-key
# Leave empty when PrimeOS web and backend share the same domain via /api.
VITE_PRIME_ADMIN_API_BASE=
