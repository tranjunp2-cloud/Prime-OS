{
  "buildCommand": "npm run build --workspace @primeos/admin",
  "outputDirectory": "apps/admin/dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/api/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
