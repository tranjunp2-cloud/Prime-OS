{
  "name": "primeos",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev:5177 --workspace @primeos/web -- --host 127.0.0.1",
    "dev:admin": "npm run dev --workspace @primeos/admin",
