# Copy this file to .env.local and fill in your Supabase project credentials
# Get these from: https://supabase.com/dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-anon-or-publishable-key
VITE_PRIME_ADMIN_API_BASE=http://127.0.0.1:8180

# Do not put service-role or private keys in any VITE_* variable.
# Production builds reject localhost/demo placeholder values.
